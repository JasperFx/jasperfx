<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <TargetFrameworks></TargetFrameworks>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>

        <!--
        jasperfx#1141: the JasperFx command line, run from a Native AOT binary. The app is shaped like
        the one in the issue: WebApplication.CreateSlimBuilder, CritterStackDefaults, ApplyJasperFxExtensions
        and RunJasperFxCommands, with JasperFx.SourceGenerator over the app, JasperFx and JasperFx.Events.

        `./build.sh smoke-test-aot-cli` publishes it with PublishAot and runs the native binary through
        help, help <command>, an application command (generated parser, enumerable flag, [InjectService]),
        check-env, describe and run, asserting on exit codes and output. Before #1141 every one of those
        failed in the native binary while working under `dotnet run`.

        The gate is what the native binary does, not a clean ILC log: the IL warnings are deliberately NOT
        errors here. Reaching the command line pulls in commands whose own bodies still reflect
        (describe's OptionsDescription, stream-query's aggregate-type lookup, System.Linq.Dynamic.Core),
        and ILC reports those whether or not the gate's commands touch them. JasperFx.AotSmoke is the
        analyzer-clean gate for the AOT-clean surface.
        -->
        <!-- In the project rather than on the command line: a global PublishAot reaches every referenced
             project, including the netstandard2.0 source generator, which cannot be AOT-compiled. -->
        <PublishAot>true</PublishAot>
        <IsAotCompatible>true</IsAotCompatible>
        <TrimMode>full</TrimMode>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\JasperFx\JasperFx.csproj" />
        <ProjectReference Include="..\JasperFx.Events\JasperFx.Events.csproj" />
        <ProjectReference Include="..\JasperFx.SourceGenerator\JasperFx.SourceGenerator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
