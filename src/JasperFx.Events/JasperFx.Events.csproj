<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Foundational Event Store Abstractions and Projections for the Critter Stack</Description>
        <PackageId>JasperFx.Events</PackageId>
        <Version>$(JasperFxVersion)</Version>
        <!-- AOT pillar (jasperfx#213). Enables IL2026/IL2075/IL3050 analyzers so any
             reflective surface that isn't already annotated surfaces during our own
             build. JasperFx.csproj carries the same flag — together they're the
             punch-list source for the AOT pillar. -->
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\JasperFx\JasperFx.csproj"/>
        <ProjectReference Include="..\JasperFx.Events.SourceGenerator\JasperFx.Events.SourceGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- jasperfx#891. buildTransitive rather than build: the duplicate analyzer copies this target
             removes usually reach a project transitively through a store package, not through a direct
             reference to JasperFx.Events. The file name has to match the package id for NuGet to import
             it. -->
        <None Include="build\JasperFx.Events.targets"
              Pack="true"
              PackagePath="buildTransitive\JasperFx.Events.targets"
              Visible="false" />
    </ItemGroup>

</Project>
