<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>An in-memory document and event store for prototyping a Critter Stack application from stub types before choosing Marten, Polecat or Fisher. Deliberately short-lived: it refuses to start in Production.</Description>
        <AssemblyName>JasperFx.Events.InMemory</AssemblyName>
        <PackageId>JasperFx.Events.InMemory</PackageId>
        <Version>$(JasperFxVersion)</Version>
        <PackageTags>jasperfx;events;documents;in-memory;prototyping;critter-stack</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\JasperFx.Events\JasperFx.Events.csproj" />
        <ProjectReference Include="..\JasperFx.Events.SourceGenerator\JasperFx.Events.SourceGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- jasperfx#964: live aggregation folds with source-generated Apply / Create dispatchers and there is
         no runtime fallback, but the generator does not flow transitively from JasperFx.Events. So, like
         Marten (marten#4557), this package carries the analyzer in analyzers/dotnet/cs and every project
         that references it runs the generator. Contributed once, from a single TFM, to avoid a duplicate
         package file. -->
    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_BundleEventsSourceGeneratorAnalyzer</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="_BundleEventsSourceGeneratorAnalyzer" Condition="'$(TargetFramework)' == 'net9.0'">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)..\JasperFx.Events.SourceGenerator\bin\$(Configuration)\netstandard2.0\JasperFx.Events.SourceGenerator.dll">
                <PackagePath>analyzers/dotnet/cs</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>

    <ItemGroup>
        <InternalsVisibleTo Include="EventStoreTests" />
        <InternalsVisibleTo Include="InMemoryEventStoreTests" />
    </ItemGroup>
</Project>
