<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- Explicit now that Microsoft.NET.Test.Sdk is gone: it used to set this. An xunit v3
             test project is its own MTP executable and won't build without it. -->
        <OutputType>Exe</OutputType>
        <Version>1.2.0</Version>
    </PropertyGroup>

    <!--
      jasperfx#1053: the union event tests use the C# 15 `union` keyword, which only compiles on
      net11.0 and still needs the preview language version on the .NET 11 SDK. Scoped to this test
      project's net11.0 build; the libraries stay on Directory.Build.props' LangVersion.
    -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <LangVersion>preview</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\JasperFx.Events\JasperFx.Events.csproj" />
        <ProjectReference Include="..\JasperFx\JasperFx.csproj" />
        <ProjectReference Include="..\JasperFx.Events.SourceGenerator\JasperFx.Events.SourceGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Class1.cs" />

        <!--
          jasperfx#1045: compiled from source, because that is how a store consumes the compliance
          package. The partial's other half lives in Projections/MessageOutboxBridgeTests.cs, and a
          library change that would break a consumer's half fails this build.
        -->
        <Compile Include="..\JasperFx.Events.ComplianceTests\RecordingMessageOutbox.cs"
                 Link="ComplianceTests\RecordingMessageOutbox.cs" />

        <!-- jasperfx#1050: same reason. Its Hits count is what the compliance suite leans on. -->
        <Compile Include="..\JasperFx.Events.ComplianceTests\RecordingAggregateWriteCache.cs"
                 Link="ComplianceTests\RecordingAggregateWriteCache.cs" />
    </ItemGroup>
</Project>
