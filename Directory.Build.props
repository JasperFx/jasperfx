<?xml version="1.0" encoding="utf-8"?>
<Project>
    <PropertyGroup>
        <JasperFxVersion>3.2.0</JasperFxVersion>
        <LangVersion>14</LangVersion>
        <NoWarn>1570;1571;1572;1573;1574;1587;1591;1701;1702;1711;1735;0618</NoWarn>
        <Authors>Jeremy D. Miller;Jaedyn Tonee</Authors>
        <PackageIcon>logo.jpg</PackageIcon>
        <PackageProjectUrl>http://github.com/jasperfx/jasperfx</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <NoWarn>1570;1571;1572;1573;1574;1587;1591;1701;1702;1711;1735;0618</NoWarn>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AddSyntheticProjectReferencesForSolutionDependencies>false</AddSyntheticProjectReferencesForSolutionDependencies>
    </PropertyGroup>

    <!--
      Microsoft Testing Platform (#581). UseMicrosoftTestingPlatformRunner makes xunit v3 build its MTP
      entry point. It is repo-wide because global.json's test.runner puts `dotnet test` in MTP mode for
      the whole repo, and it is inert in projects that don't reference xunit.v3. That mode takes a
      project through the project option, and prints failing tests inline, so a CI log names what broke.
    -->
    <PropertyGroup>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <!--
          Without this, a failing test prints only

            error run failed: Tests failed: '.../TestResults/EventStoreTests_net10.0_x64.log'

          and the test name, assertion and stack trace go to that file. On a CI runner the file is
          never published, so the log is all anyone gets - a red build with no way to tell what
          broke. The VSTest bridge printed failures inline, and this restores that.
        -->
        <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    </PropertyGroup>

    <!--
      Runtime-async (jasperfx#1040, on by default since jasperfx#1180, plan decision D4). The net11.0 assemblies compile with the
      C# compiler's runtime-async feature unless a build passes -p:JasperFxRuntimeAsync=false. net11.0 only: on net10.0 the
      compiler refuses it (SYSLIB5007) and the runtime will not load it. Needs Roslyn 5.x (the .NET 11 SDK's). Changing it does
      not trigger a recompile, so clean bin/ and obj/ between a build with it and a build without.
    -->
    <PropertyGroup Condition="'$(JasperFxRuntimeAsync)' != 'false' And '$(TargetFramework)' == 'net11.0'">
        <Features>$(Features);runtime-async=on</Features>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="All"/>
    </ItemGroup>

    <!-- Pack the shared repo-root logo into every IsPackable=true package
         (NU5048 fix — replaces the deprecated PackageIconUrl from issue #221). -->
    <ItemGroup Condition="'$(IsPackable)' != 'false'">
        <None Include="$(MSBuildThisFileDirectory)logo.jpg" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <!-- Pack the per-project README.md when one exists. PackageReadmeFile is
         set globally above (issue #222 fix); each packed project authors its
         own README in its csproj directory. Non-packed projects (tests, demo
         apps) don't need one. -->
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
        <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

</Project>
